pkgbase = clockmost-shell
	pkgdesc = The clockmost Endfield desktop shell for KDE Plasma: bar, control center, dock, app drawer, notifications, Win+V clipboard (Quickshell)
	pkgver = 0.1.9
	pkgrel = 2
	url = https://git.clockmost.com/pkgs/clockmost-shell
	install = clockmost-shell.install
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = mold
	depends = gcc-libs
	depends = glibc
	depends = quickshell
	depends = qt6-websockets
	depends = sqlite
	depends = wl-clipboard
	options = !lto
	options = !debug

pkgname = clockmost-shell
