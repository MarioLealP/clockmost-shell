pkgbase = clockmost-shell
	pkgdesc = The clockmost desktop shell for KDE Plasma: v2 desktop layer (ground), bar, control center, dock, app drawer, notifications, Win+V clipboard (Quickshell)
	pkgver = 0.2.9
	pkgrel = 1
	url = https://git.clockmost.com/pkgs/clockmost-shell
	install = clockmost-shell.install
	arch = x86_64
	license = MIT
	license = OFL-1.1
	makedepends = rust
	makedepends = cargo
	makedepends = mold
	depends = gcc-libs
	depends = glibc
	depends = quickshell
	depends = qt6-websockets
	depends = sqlite
	depends = wl-clipboard
	options = !lto
	options = !debug

pkgname = clockmost-shell
